#!/usr/bin/env python3
"""
vshort: Convert landscape (16:9) clips into vertical (9:16) Shorts/Reels/TikTok format.
Supports:
  - blur: Blurred background stack (standard social media highlight style)
  - crop: Center crop to 9:16
  - fit: Letterbox fit to 9:16
"""
import sys
import os
import argparse
import subprocess
import shutil

def main():
    parser = argparse.ArgumentParser(
        description="vshort: Turn clips into vertical (9:16) format for Shorts, Reels, and TikTok",
        epilog="Examples:\n  vshort clip.mp4 short.mp4\n  vshort clip.mp4 short.mp4 --style crop\n  vshort clip.mp4 short.mp4 --style fit",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("input", help="Input clip file")
    parser.add_argument("output", nargs="?", default=None, help="Output vertical video file (default: auto-named)")
    parser.add_argument("-s", "--style", choices=["blur", "crop", "fit"], default="blur",
                        help="Formatting style: 'blur' (blurred background, default), 'crop' (center crop), 'fit' (letterboxed)")
    parser.add_argument("--width", type=int, default=1080, help="Output width (default: 1080)")
    parser.add_argument("--height", type=int, default=1920, help="Output height (default: 1920)")

    args = parser.parse_args()
    if not os.path.isfile(args.input):
        print(f"Error: File '{args.input}' not found.", file=sys.stderr)
        sys.exit(1)

    if not args.output:
        base, ext = os.path.splitext(args.input)
        args.output = f"{base}_9x16_{args.style}{ext}"

    ffmpeg = shutil.which("ffmpeg") or "/home/agent/.local/bin/ffmpeg"
    w, h = args.width, args.height

    if args.style == "blur":
        # Complex filter:
        # 1. Background: scale to fill 1080x1920, boxblur
        # 2. Foreground: scale to width 1080 maintaining aspect ratio
        # 3. Overlay foreground on blurred background
        filter_complex = (
            f"[0:v]scale={w}:{h}:force_original_aspect_ratio=increase,crop={w}:{h},boxblur=20:5[bg];"
            f"[0:v]scale={w}:-1:force_original_aspect_ratio=decrease[fg];"
            f"[bg][fg]overlay=(W-w)/2:(H-h)/2[outv]"
        )
    elif args.style == "crop":
        filter_complex = f"[0:v]scale=-1:{h},crop={w}:{h}[outv]"
    else: # fit
        filter_complex = f"[0:v]scale={w}:{h}:force_original_aspect_ratio=decrease,pad={w}:{h}:(ow-iw)/2:(oh-ih)/2[outv]"

    cmd = [
        ffmpeg, "-y",
        "-i", args.input,
        "-filter_complex", filter_complex,
        "-map", "[outv]",
        "-map", "0:a?",
        "-c:v", "libx264",
        "-preset", "fast",
        "-crf", "20",
        "-c:a", "aac",
        "-b:a", "192k",
        args.output
    ]

    print(f"📱 Creating vertical short ({w}x{h}, style={args.style})...")
    ret = subprocess.run(cmd)
    if ret.returncode == 0:
        print(f"✅ Created vertical short: {args.output}")
    else:
        print(f"❌ Failed to convert video (exit code {ret.returncode})", file=sys.stderr)
        sys.exit(ret.returncode)

if __name__ == "__main__":
    main()
