#!/usr/bin/env python3
"""
vclip: Fast and precise video clipping utility.
Supports instant lossless cuts (stream copy) or frame-accurate re-encoding.
"""
import sys
import os
import argparse
import subprocess
import shutil

def format_time(t_str):
    """Normalize time format into HH:MM:SS or SS.ms"""
    t_str = t_str.strip()
    if ":" not in t_str:
        try:
            val = float(t_str)
            m, s = divmod(val, 60)
            h, m = divmod(m, 60)
            return f"{int(h):02d}:{int(m):02d}:{s:06.3f}"
        except ValueError:
            return t_str
    parts = t_str.split(":")
    if len(parts) == 2:
        return f"00:{int(parts[0]):02d}:{float(parts[1]):06.3f}"
    return t_str

def main():
    parser = argparse.ArgumentParser(
        description="vclip: Ultra-fast video clipping tool powered by FFmpeg",
        epilog="Examples:\n  vclip input.mp4 00:01:20 00:01:45 output.mp4\n  vclip input.mp4 10 35 clip.mp4 --lossless\n  vclip input.mp4 01:00 02:00 clip.mp4 --reencode --crf 18",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("input", help="Input video file path")
    parser.add_argument("start", help="Start time (e.g., 00:01:30, 90, or 01:30)")
    parser.add_argument("end", help="End time (e.g., 00:02:15, 135, or 02:15)")
    parser.add_argument("output", nargs="?", default=None, help="Output file path (default: auto-named)")
    parser.add_argument("-l", "--lossless", action="store_true", default=True, help="Lossless cut without re-encoding (default, fastest)")
    parser.add_argument("-r", "--reencode", action="store_true", help="Re-encode for frame-accurate cuts at exact I/P/B frames")
    parser.add_argument("--crf", type=int, default=20, help="CRF quality when re-encoding (default: 20)")
    parser.add_argument("--preset", default="fast", help="FFmpeg preset (e.g. ultrafast, fast, medium)")

    args = parser.parse_args()

    if not os.path.isfile(args.input):
        print(f"Error: Input file '{args.input}' not found.", file=sys.stderr)
        sys.exit(1)

    start_t = format_time(args.start)
    end_t = format_time(args.end)

    if not args.output:
        base, ext = os.path.splitext(args.input)
        s_clean = args.start.replace(":", "-").replace(".", "_")
        e_clean = args.end.replace(":", "-").replace(".", "_")
        args.output = f"{base}_clip_{s_clean}_to_{e_clean}{ext}"

    ffmpeg = shutil.which("ffmpeg") or "/home/agent/.local/bin/ffmpeg"

    if args.reencode:
        cmd = [
            ffmpeg, "-y",
            "-ss", start_t,
            "-to", end_t,
            "-i", args.input,
            "-c:v", "libx264",
            "-preset", args.preset,
            "-crf", str(args.crf),
            "-c:a", "aac",
            "-b:a", "192k",
            "-avoid_negative_ts", "make_zero",
            args.output
        ]
    else:
        # Lossless fast copy
        cmd = [
            ffmpeg, "-y",
            "-ss", start_t,
            "-to", end_t,
            "-i", args.input,
            "-c", "copy",
            "-avoid_negative_ts", "make_zero",
            args.output
        ]

    print(f"🎬 Clipping '{args.input}' [{start_t} -> {end_t}] to '{args.output}'...")
    ret = subprocess.run(cmd)
    if ret.returncode == 0:
        print(f"✅ Successfully created clip: {args.output}")
        if os.path.exists(args.output):
            size_mb = os.path.getsize(args.output) / (1024 * 1024)
            print(f"📊 Size: {size_mb:.2f} MB")
    else:
        print(f"❌ Failed to create clip (exit code {ret.returncode})", file=sys.stderr)
        sys.exit(ret.returncode)

if __name__ == "__main__":
    main()
